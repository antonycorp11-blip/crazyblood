{
  "name": "hemofarm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "assets:sync": "node scripts/sync-assets.mjs",
    "sim": "esbuild scripts/balance-sim.ts --bundle --platform=node --format=esm --log-level=warning --define:import.meta.env.DEV=false --outfile=node_modules/.cache/balance-sim.mjs && node node_modules/.cache/balance-sim.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
